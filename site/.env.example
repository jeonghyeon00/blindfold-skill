# Public URL of the deployed site, used for canonical, hreflang, Open Graph, robots.txt and sitemap.xml.
# Copy to .env to override locally (no trailing slash). CI uses the SITE_URL repository variable;
# when neither is set, vite.config.ts falls back to https://blindfold.cmdrun.net.
VITE_SITE_URL=https://blindfold.cmdrun.net
